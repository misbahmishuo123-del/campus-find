# ===== CampusFind Backend Environment =====
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file to source control.

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string (with your DB user + password)
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=YOUR_JWT_SECRET

# Optional: Gemini API key. Used ONLY from the backend, and ONLY as an
# optional enhancement. The app works fully without it.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: restrict student/staff registration to this email domain
# (e.g. university.edu). Leave empty to allow any valid email.
UNIVERSITY_EMAIL_DOMAIN=
